{
  "name": "apollo-enriched-voice-engine",
  "version": "1.0.0",
  "description": "Sub-850ms TTFT Autonomous Inbound Voice Engine with Dynamic Apollo.io Firmographic Prompt Synthesis",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts"
  },
  "keywords": [
    "voice-ai",
    "retell-ai",
    "twilio-voice",
    "apollo-io",
    "sub-850ms",
    "firmographic-enrichment",
    "realtime-audio",
    "gohighlevel",
    "groq",
    "llama-3.3"
  ],
  "author": "Muhammad Hamza <hamza@hamzabuildai.com>",
  "license": "MIT",
  "homepage": "https://hamzabuildai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/muhammadhamza180/apollo-enriched-voice-engine.git"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
